# ---------------------------------------------------------------------------
# Reference databases and sequencing data are NEVER committed.
#
# Measured on the source project: 113 GB total, of which REFERENCE_DB alone is
# 28 GB. The code itself is a few MB. Databases are fetched and verified by
# `bash install.sh databases`, which checks record counts and alphabet after every
# download instead of trusting the URL.
# ---------------------------------------------------------------------------
REFERENCE_DB/
sequences/*
!sequences/.gitkeep
!sequences/README.md
examples/*.fasta
examples/*.fastq
examples/*.fq
examples/*.fa

# Raw and intermediate sequence data
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fasta
*.fa
*.fna
*.bam
*.sam
*.cram
*.qza
*.qzv
# ...but keep the small curated tables the pipeline needs
!steps/targets.tsv
!steps/reference_targets.tsv
!steps/taxid_names.tsv
!steps/F2_ITS_window.fa
!screening/*.tsv
!examples/*.tsv

# ---------------------------------------------------------------------------
# Run outputs. Every one of these is regenerated by a run; committing them
# would make the repo unreadable and invite stale numbers into review.
# ---------------------------------------------------------------------------
*_RESULT/
*_RESULT_PREVIOUS_*/
SCREENING_RESULT/
IDENTITY_RESULT/
CROSSCHECK_RESULT/
VERIFICATION_RESULT/
ALL_IDENTITIES_RESULT/
ALL_STAGES_RESULT/
ONE_PROTOCOL_RESULT/
RECOVERY_RESULT/
# RESULTS/ holds the Kraken tool's own outputs: inspect dumps, the database
# fingerprint table and the merged read pools. All of them are regenerated.
RESULTS/
# kraken_tool.sh and install.sh write their run logs here.
install_logs/
FULL_CHAIN_RESULT/
KRAKEN_KARSILASTIRMA.*
REFERENCE_DESIGN_RESULT/
OTHER_LOCUS_RESULT/
ACCESS_RESULT/
QIIME2_RESULT/
QUICK_TEST/
install_logs/

# Checkpoints and caches
kontrol/
onbellek/
*.pkl
durum.json
vtb_*.json
iddia_*.json
nt_*.json

# Index sidecar files built from the databases
*.fai
*.ndb
*.nhr
*.nin
*.njs
*.not
*.nsq
*.ntf
*.nto
*.primerqc
*.primerqc.bin
*.ortuz

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.orig
*.orig_*
*.DUZELTILMIS
*.yedek*
*.BOZUK*
*.SUPHELI
*.log
*.tmp
ARCHIVE/
_to_delete/
_yeniden_adlandirma/

# Office lock files (LibreOffice/Excel leave these behind)
.~lock.*#
~$*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
